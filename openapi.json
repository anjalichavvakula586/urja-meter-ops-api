{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API",
    "version": "0.1.0",
    "description": "Clean read-only API in front of the Urja Meter Ops portal. Upstream URLs for login/search/geo/energy are configurable and pending verification (see PROTOCOL.md)."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Search meters",
        "operationId": "search_meters",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Meter number or serial; empty returns the default listing",
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "example": {
                  "query": "J100000",
                  "page": 1,
                  "count": 1,
                  "items": [
                    {
                      "meter_id": "J100000",
                      "serial_no": "SE33962",
                      "make": "HPL",
                      "phase_type": "single",
                      "install_status": "Decommissioned",
                      "dt_code": "DT-001"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failed, rejected our credentials, or returned an unexpected payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service not configured (missing upstream credentials)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Upstream portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/location": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Meter coordinates",
        "operationId": "meter_location",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "description": "Meter identifier, e.g. J100000",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "example": "J100000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationResponse"
                },
                "example": {
                  "meter_id": "J100000",
                  "latitude": 26.938961002479868,
                  "longitude": 75.83095696146852
                }
              }
            }
          },
          "404": {
            "description": "Upstream reports no such meter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failed, rejected our credentials, or returned an unexpected payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service not configured (missing upstream credentials)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Upstream portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/energy": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Energy readings",
        "operationId": "meter_energy",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "description": "Meter identifier, e.g. J100000",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "example": "J100000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyResponse"
                },
                "example": {
                  "meter_id": "J100000",
                  "count": 1,
                  "readings": [
                    {
                      "timestamp": "2026-06-24T00:30:00",
                      "timestamp_raw": "24/06/2026 00:30",
                      "kwh": 48439.58,
                      "kvah": 52314.75,
                      "volt_r": 220.0
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Upstream reports no such meter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream failed, rejected our credentials, or returned an unexpected payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service not configured (missing upstream credentials)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Upstream portal timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "query",
          "page",
          "count",
          "items"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "count": {
            "type": "integer",
            "description": "Number of items on this page"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            }
          }
        }
      },
      "LocationResponse": {
        "type": "object",
        "required": [
          "meter_id",
          "latitude",
          "longitude"
        ],
        "properties": {
          "meter_id": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "EnergyReading": {
        "type": "object",
        "required": [
          "timestamp",
          "timestamp_raw"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "ISO-8601 local time WITHOUT offset (portal timezone unknown)",
            "example": "2026-06-24T00:30:00"
          },
          "timestamp_raw": {
            "type": "string",
            "description": "Original portal string",
            "example": "24/06/2026 00:30"
          },
          "kwh": {
            "type": [
              "number",
              "null"
            ]
          },
          "kvah": {
            "type": [
              "number",
              "null"
            ]
          },
          "volt_r": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "EnergyResponse": {
        "type": "object",
        "required": [
          "meter_id",
          "count",
          "readings"
        ],
        "properties": {
          "meter_id": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "MeterSummary": {
        "type": "object",
        "required": [
          "meter_id"
        ],
        "properties": {
          "meter_id": {
            "type": "string",
            "example": "J100000"
          },
          "serial_no": {
            "type": [
              "string",
              "null"
            ],
            "example": "SE33962"
          },
          "make": {
            "type": [
              "string",
              "null"
            ],
            "example": "HPL"
          },
          "phase_type": {
            "type": [
              "string",
              "null"
            ],
            "example": "single"
          },
          "install_status": {
            "type": [
              "string",
              "null"
            ],
            "example": "Decommissioned"
          },
          "dt_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Distribution transformer code",
            "example": "DT-001"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ]
}
